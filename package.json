{
  "name": "porkbun-mcp",
  "mcpName": "io.github.korobkov-v/porkbun-mcp",
  "version": "0.4.0",
  "description": "MCP server for Porkbun, npx-first runtime.",
  "type": "module",
  "bin": {
    "porkbun-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
