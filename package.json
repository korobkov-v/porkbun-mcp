  "homepage": "https://github.com/korobkov-v/porkbun-mcp#readme",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.13.2",
    "tsx": "^4.23.15",
    "typescript": "^5.7.3"
  }
